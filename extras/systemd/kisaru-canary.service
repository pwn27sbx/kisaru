[Unit]
Description=Contract canary for the kisaru Spanish sources
After=network-online.target

[Service]
Type=oneshot
# Secrets (Sentry check-in URL, Discord webhook) live outside the repo, mode 600.
EnvironmentFile=%h/.config/kisaru-canary/canary.env
Environment=PYTHONDONTWRITEBYTECODE=1
# install.sh puts the config in ~/.config/kisaru and its venv in
# ~/.local/share/kisaru/venv; the canary needs the venv's interpreter, not the
# system one (audit 2026-11-06, finding 14).
ExecStart=%h/.local/share/kisaru/venv/bin/python3 %h/.config/kisaru/scripts/source_canary.py
